{
    "name": "paulopacheco-site",
    "private": true,
    "description": "Personal site (static) with Playwright + TypeScript tests (agentic-playwright scaffold, MIT)",
    "scripts": {
        "test": "npx playwright test --grep-invert @destructive",
        "test:chromium": "npx playwright test --project=chromium --grep-invert @destructive",
        "test:ci": "npx playwright test --project=chromium --workers=1",
        "test:debug": "npx playwright test --project=chromium --debug",
        "test:ui": "npx playwright test --project=chromium --ui",
        "test:headed": "npx playwright test --project=chromium --headed --grep-invert @destructive",
        "test:smoke": "npx playwright test --grep @smoke --project=chromium",
        "test:sanity": "npx playwright test --grep @sanity --project=chromium",
        "test:regression": "npx playwright test --grep @regression --project=chromium",
        "test:e2e": "npx playwright test --grep @e2e --project=chromium",
        "test:destructive": "npx playwright test --grep @destructive --project=chromium --workers=1",
        "report": "npx playwright show-report",
        "lint": "npx eslint . --max-warnings 0",
        "lint:fix": "npx eslint . --fix",
        "format": "npx prettier --write .",
        "playwright-cli:install-browsers": "node scripts/install-playwright-cli-browsers.js",
        "check:agents-md": "bash scripts/check-agents-md.sh",
        "check:skills-sync": "bash scripts/check-skills-sync.sh",
        "check:skills-drift": "bash scripts/check-rules-drift.sh",
        "check:skills-references": "bash scripts/check-skill-references-drift.sh",
        "check:skills-headings": "bash scripts/check-heading-pointers.sh",
        "check:skills-crossrefs": "bash scripts/check-skill-crossrefs.sh",
        "check:skills-shape": "bash scripts/check-skill-shape.sh",
        "check:skills": "npm run check:agents-md && npm run check:skills-sync && npm run check:skills-shape && npm run skills:verify && npm run check:skills-drift && npm run check:skills-references && npm run check:skills-headings && npm run check:skills-crossrefs",
        "skills:sync": "bash scripts/sync-skills.sh",
        "skills:verify": "bash scripts/sync-upstream-skills.sh verify",
        "skills:reinstall": "bash scripts/sync-upstream-skills.sh reinstall",
        "skills:update": "bash scripts/sync-upstream-skills.sh update",
        "lighthouse": "node scripts/lighthouse.mjs",
        "serve": "node scripts/serve.js",
        "check": "npm run lint && npm test && node scripts/lighthouse.mjs",
        "postinstall": "is-ci || husky"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@faker-js/faker": "^10.6.0",
        "@playwright/cli": "^0.1.24",
        "@playwright/test": "^1.65.0",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.1",
        "chrome-launcher": "^1.2.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.7",
        "husky": "^9.1.7",
        "is-ci": "^4.1.0",
        "jiti": "^2.7.0",
        "lighthouse": "^13.6.0",
        "lint-staged": "^17.6.0",
        "playwright": "^1.64.1"
    },
    "dependencies": {
        "dotenv": "^18.0.10",
        "zod": "^4.6.7"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "npx eslint --fix --max-warnings 0 --no-warn-ignored",
            "npx prettier --write"
        ]
    },
    "engines": {
        "node": ">=22"
    }
}
